# Database
DATABASE_URL=sqlite:///./ewaste_chainguard.db

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=E-Waste ChainGuard
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Trusted development provisioning (keep credentials in uncommitted .env only).
# User-facing roles map to PRODUCER, RECYCLER_EMPLOYEE and GOVERNMENT_OFFICER.
BOOTSTRAP_USERS_JSON=[]
BOOTSTRAP_MEMBERSHIPS_JSON=[]
BOOTSTRAP_FACILITIES_JSON=[]
BOOTSTRAP_JURISDICTIONS_JSON=[]

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Verification Engine
VERIFICATION_MODEL_VERSION=risk-engine-v3.0.0
VERIFICATION_RULESET_VERSION=risk-rules-v3.0.0
MAX_HGV_SPEED_KMH=90
MASS_BALANCE_TOLERANCE_PCT=5.0
PHASH_DUPLICATE_THRESHOLD=0.90
RISK_RULE_WEIGHTS_JSON={}
RISK_GROUP_CAPS_JSON={"MASS_BALANCE":30,"TRANSPORT":30,"DOCUMENT_CONSISTENCY":30,"EVIDENCE_INTEGRITY":30,"DUPLICATE":35,"COMPLETENESS":0}
RISK_BAND_LOW_MAX=25
RISK_BAND_MEDIUM_MAX=50
RISK_BAND_HIGH_MAX=75

# Private local evidence storage (10 MB upload limit)
EVIDENCE_STORAGE_ROOT=./evidence_store
EVIDENCE_MAX_FILE_SIZE=10485760

# AWS (for production)
# AWS_REGION=eu-west-1
# S3_BUCKET_NAME=ewaste-chainguard-evidence
# TEXTRACT_ENABLED=false
# REKOGNITION_ENABLED=false
